APP_NAME=Village Connect
APP_URL=https://localhost:8443
APP_ENV=local
APP_DEBUG=false

# Production: APP_ENV=production APP_DEBUG=false (debug is forced off when APP_ENV=production)

# HTTPS / HSTS (enabled automatically when served over TLS)
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# Database (Docker: DB_HOST=db)
DB_HOST=db
DB_PORT=5432
DB_DATABASE=project_cms
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Mail — production SMTP or Mailpit for local dev
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_ENCRYPTION=none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Village Connect
SITE_CONTACT_EMAIL=admin@example.com

# OAuth (optional — leave empty to hide social login buttons)
OAUTH_BASE_URL=https://localhost:8443
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://localhost:8443/auth/google-callback.php
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://localhost:8443/auth/facebook-callback.php
FACEBOOK_OAUTH_SCOPE=email,public_profile

# Cloudinary (optional — for CDN media uploads)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=village-connect

PRETTY_URLS=true

# Rate limiting — database (default when PostgreSQL is available) or session
RATE_LIMIT_DRIVER=database
TRUST_PROXY=false

# Web Push (optional — run: php scripts/generate_vapid.php)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
