APP_NAME=Village Connect
APP_URL=http://localhost:8080
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=Asia/Phnom_Penh

PRETTY_URLS=true
SESSION_DRIVER=database
RATE_LIMIT_DRIVER=database
TRUST_PROXY=false

HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# Supabase Postgres: Project Settings → Database → Connection string (Session pooler)
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_supabase_database_password
DB_SSLMODE=require

# Mail — SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Village Connect
SITE_CONTACT_EMAIL=admin@example.com

# OAuth (optional — leave empty to hide social login buttons)
OAUTH_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_SCOPE=email,public_profile

# Cloudinary (optional — for CDN media uploads)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=village-connect

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
