APP_NAME=Village Connect
APP_URL=http://localhost:8080
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=Asia/Phnom_Penh

# Local: http://localhost:8080
# Northflank / Render: set env vars in platform dashboard — see README

# HTTPS / HSTS (only sent when the site is served over TLS)
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# Database — local Docker Postgres, Supabase, or Neon (https://neon.tech)
#
# Local Docker (default): DB_HOST=db, no SSL
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=project_cms
# DB_USERNAME=postgres
# DB_PASSWORD=change_me_use_strong_random_password
#
# Supabase Postgres: Project Settings → Database → Connection string
# Use "Session pooler" (IPv4) if Docker/local tools cannot reach direct host (IPv6-only).
# DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your_project_ref
# DB_PASSWORD=your_supabase_database_password
# DB_SSLMODE=require
#
# Neon Postgres (Koyeb / Render free stack): Dashboard → Connection string
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Or set DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD, DB_SSLMODE=require
DB_HOST=db
DB_PORT=5432
DB_DATABASE=project_cms
DB_USERNAME=postgres
# Use a long random password (min 24 chars). Generate: php -r "echo bin2hex(random_bytes(24));"
DB_PASSWORD=change_me_use_strong_random_password
# DB_SSLMODE=require

# Mail — production SMTP or Mailpit for local dev
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_ENCRYPTION=none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Village Connect
SITE_CONTACT_EMAIL=admin@example.com

# OAuth (optional — leave empty to hide social login buttons)
OAUTH_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_SCOPE=email,public_profile

# Cloudinary (optional — for CDN media uploads)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=village-connect

# Language switcher in navbar (off until translations are ready for users)
# I18N_USER_SWITCHER_ENABLED=true

PRETTY_URLS=true

# Rate limiting — database (default when PostgreSQL is available) or session
RATE_LIMIT_DRIVER=database
SESSION_DRIVER=database
TRUST_PROXY=false

# Web Push (optional — run: php scripts/generate_vapid.php)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
