APP_NAME=Village Connect
APP_URL=http://localhost:8080
APP_ENV=local
APP_DEBUG=false

# Local: http://localhost:8080 — Production: APP_URL=https://yourdomain.com (see docker-compose.prod.yml)

# HTTPS / HSTS (only sent when the site is served over TLS)
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# Database (Docker: DB_HOST=db — no host port; use docker compose exec db for psql)
# If you need host access, add to docker-compose db.ports: "127.0.0.1:5433:5432" and set DB_PORT=5433
DB_HOST=db
DB_PORT=5432
DB_DATABASE=project_cms
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Mail — production SMTP or Mailpit for local dev
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_ENCRYPTION=none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Village Connect
SITE_CONTACT_EMAIL=admin@example.com

# OAuth (optional — leave empty to hide social login buttons)
OAUTH_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_SCOPE=email,public_profile

# Cloudinary (optional — for CDN media uploads)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=village-connect

# Language switcher in navbar (off until translations are ready for users)
# I18N_USER_SWITCHER_ENABLED=true

PRETTY_URLS=true

# --- Oracle Cloud / VPS production ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://yourdomain.com
# DOMAIN=yourdomain.com
# NGINX_CONF=production-init.conf
# TRUST_PROXY=true
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls

# Rate limiting — database (default when PostgreSQL is available) or session
RATE_LIMIT_DRIVER=database
TRUST_PROXY=false

# Web Push (optional — run: php scripts/generate_vapid.php)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
